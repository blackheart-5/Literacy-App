# ---- Required ----

# MongoDB connection string.
# Local dev:  mongodb://localhost:27017/literacy-app
# Production: use a hosted MongoDB (e.g. MongoDB Atlas) connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/literacy-app?retryWrites=true&w=majority
MONGODB_URL=

# Secret used to sign session JWT cookies. Use a long random string.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=
